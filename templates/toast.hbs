<div class="au-toast">
  <div class="au-toast-badge">
    {{> "achievements-unlocked.badge" img=img size="lg"}}
  </div>
  <div class="au-toast-body">
    <div class="au-toast-header"><i class="fas fa-trophy"></i> {{header}}</div>
    <div class="au-toast-name">{{name}}</div>
    <div class="au-toast-desc">{{description}}</div>
    <div class="au-toast-who">{{recipientsText}}</div>
  </div>
</div>
